---
// Pictogrammes en ligne (pas de dépendance externe).
interface Props {
  name: 'whatsapp' | 'phone' | 'pin' | 'clock' | 'instagram' | 'facebook' | 'tiktok' | 'menu' | 'close' | 'glasses' | 'calendar' | 'arrow';
  class?: string;
}
const { name, class: className } = Astro.props;
---

---
// Logo provisoire redessiné d'après l'identité Instagram (monture + VER'OPTIC).
// À remplacer par le fichier vectoriel officiel dès réception.
interface Props { class?: string }
const { class: className = '' } = Astro.props;
---
<a href="/" class={`logo ${className}`} aria-label="VER'OPTIC, accueil">
  <svg viewBox="0 0 64 26" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M3 6h58"/>
    <path d="M5 6c0 0 .5 10 3 13s12 3 15 0 4-13 4-13"/>
    <path d="M37 6c0 0 1 10 4 13s12 3 15 0 3-13 3-13"/>
    <path d="M27 7.5c2.5-1.5 7.5-1.5 10 0"/>
  </svg>
  <span>VER’OPTIC</span>
</a>
